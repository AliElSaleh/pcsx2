Assembly %_FileName
Type     static_lib

if windows Compiler cl

SourceDirectory        src
BuildDirectory         bin
IntermediateDirectory  int

Compiler.Flags          /EHsc
Compiler.Includes      include src ../../deps/include subprojects

Compiler.Defines [
    OUTSIDE_SPEEX
    FLOATING_POINT
    EXPORT=
    RANDOM_PREFIX=speex
]

SourceFiles [
    cubeb.c
    cubeb_mixer.cpp
    cubeb_resampler.cpp
    cubeb_log.cpp
    cubeb_strings.c
    cubeb_utils.cpp
]
