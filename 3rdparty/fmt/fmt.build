Assembly     fmt

Type:shared  shared_library
Type:!shared static_library

Compiler:windows msvc
Compiler:!windows clang++

SourceDirectory     src
SourceFiles.Exclude fmt.cc

BuildDirectory:debug  Build/Debug
BuildDirectory:!debug Build/Release

Compiler.Includes                include
Compiler.Includes.Export         include

Compiler.Defines:shared          FMT_SHARED FMT_LIB_EXPORT
Compiler.Defines:!shared         FMT_STATIC
Compiler.Defines:windows         _WIN32
Compiler.Defines.Export:!shared  FMT_STATIC
Compiler.Defines.Export:shared   FMT_SHARED

Compiler.Flags:debug   $DebugFlags
Compiler.Flags:!debug  $ReleaseFlags

if clang++
{
    PedanticFlags:pedantic -Wall -Wextra -pedantic -Wconversion -Wundef -Wdeprecated -Wweak-vtables -Wshadow -Wno-gnu-zero-variadic-macro-arguments

    DebugFlags      -std=c++20 -O0 $PedanticFlags
    ReleaseFlags    -std=c++20 -O3 $PedanticFlags
}

if cl
{
    DebugFlags      /std:c++20 /Od /EHa /Z7 $PedanticFlags
    ReleaseFlags    /std:c++20 /O2 /EHa $PedanticFlags

    if shared
    {
        DebugFlags   /MDd
        ReleaseFlags /MD
    }
    else
    {
        DebugFlags   /MTd
        ReleaseFlags /MT
    }

    Linker.Flags:debug      /DEBUG
    Compiler.Defines:debug  _DEBUG
    Compiler.Defines:!debug NDEBUG
}
