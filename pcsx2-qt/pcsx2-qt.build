if !windows Libraries PCAP



# this would be nice
#PostBuild.Copy ../deps/bin/*.dll              $BuildDirectory/

PostBuild
{
    Copy(if_not_exist) ../deps/bin/Qt6Core.dll        $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/Qt6Gui.dll         $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/Qt6Widgets.dll     $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/Qt6Network.dll     $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/Qt6Svg.dll         $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/lz4.dll            $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/libjpeg.dll        $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/libwebp.dll        $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/zstd.dll           $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/harfbuzz.dll       $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/libsharpyuv.dll    $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/freetype.dll       $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/SDL2.dll           $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/libpng16.dll       $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/zlib1.dll          $BuildDirectory/
    Copy(if_not_exist) ../deps/bin/shaderc_shared.dll $BuildDirectory/
}

PluginsDir      $BuildDirectory/QtPlugins/
TranslationsDir $BuildDirectory/translations/

if !$PluginsDir|gen
{
    PostBuild.NewDirectory $PluginsDir
    if windows PostBuild.Cmd xcopy "..\deps\plugins\*" "$PluginsDir" /E /I /Y
    
    # need to support this natively
    #PostBuild.Copy ../deps/plugins/ $PluginsDir
}

if !$TranslationsDir|gen
{
    PostBuild.NewDirectory $TranslationsDir
    if windows PostBuild.Cmd xcopy "Generated\lrelease\*.qm" "$TranslationsDir" /E /I /Y
}

Assert.WorkingDirectory .
