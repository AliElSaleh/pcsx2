QtCompiler %%uic %%moc %%rcc %%lrelease
Compiler ../deps/bin/$QtCompiler

SourceDirectories.Exclude Generated
IntermediateDirectory Generated/$QtCompiler/.

if uic      Extension .h   ; SourceFiles *.ui  ; Assembly.Prefix ui_
if moc      Extension .cpp ; SourceFiles *.h   ; Assembly.Prefix moc_
if rcc      Extension .cpp ; SourceFiles *.qrc ; Assembly.Prefix qrc_
if lrelease Extension .qm  ; SourceFiles *.ts

if lrelease  Compiler.OutputFlag -qm
if !lrelease Compiler.OutputFlag -o

if gen AlwaysRebuild

Assert.WorkingDirectory .
Assert.Arg.OnlyOne uic moc rcc lrelease
