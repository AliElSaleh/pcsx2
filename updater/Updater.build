Assembly %_FileName
Assert.WorkingDirectory .

Depends common     ../common
Depends lzma       ../3rdparty/lzma

include           ../common.buildvars

BuildDirectory     ../bin

Compiler.Includes  . .. ../3rdparty/fmt/include ../3rdparty/fast_float/include ../3rdparty/lzma/include ../3rdparty/winwil/include

Libraries          common fmt
LibraryDirectories ../common/Build ../3rdparty/fmt/bin/Release

if windows
{
    Compiler.Includes Windows

    LinkerFlags /MANIFESTINPUT:Windows/updater.manifest /MANIFEST:EMBED

    Libraries lzma %_NativeLibs
    LibraryDirectories ../3rdparty/lzma/bin
}
else
{
    ExcludedSourceDirectories Windows
}
